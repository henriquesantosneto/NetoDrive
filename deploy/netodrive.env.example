# NetoDrive — configuração do serviço Linux
# Copiado para /etc/netodrive/netodrive.env pelo install-service.sh

NETODRIVE_ADDR=0.0.0.0:8080
NETODRIVE_DATA=/var/lib/netodrive
NETODRIVE_DB=/var/lib/netodrive/netodrive.db
NETODRIVE_JWT_SECRET=CHANGE-ME-to-a-long-random-secret
NETODRIVE_ADMIN_USER=admin
NETODRIVE_ADMIN_PASS=admin123
NETODRIVE_MAX_UPLOAD=5368709120
